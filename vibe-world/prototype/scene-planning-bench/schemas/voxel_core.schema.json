{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoxelCore",
  "oneOf": [
    { "$ref": "#/$defs/core" },
    { "$ref": "#/$defs/rejection" }
  ],
  "$defs": {
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rejection"],
      "properties": {
        "rejection": { "type": "string", "minLength": 1 }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_category", "size_tier", "materials", "operations"],
      "properties": {
        "object_category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "size_tier": { "type": "string", "minLength": 1, "maxLength": 20 },
        "style_tags": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string" }
        },
        "behaviors": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string" }
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/material" }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": { "$ref": "#/$defs/operation" }
        },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 4 },
        "scale": { "type": "number", "minimum": 0.25, "maximum": 4 }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id"],
      "properties": {
        "material_id": { "type": "string", "minLength": 1, "maxLength": 40 },
        "color_hint": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "operation": {
      "type": "object",
      "required": ["op_id", "kind"],
      "properties": {
        "op_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "material_id": { "type": "string" }
      }
    }
  }
}
