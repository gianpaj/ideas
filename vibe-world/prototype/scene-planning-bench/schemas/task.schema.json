{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "category",
    "difficulty",
    "scene_id",
    "prompts",
    "scoring_profile"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "category": { "type": "string" },
    "difficulty": { "type": "string" },
    "scene_id": { "type": "string" },
    "prompts": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "target_artifact": {
      "type": "string",
      "enum": ["scene_actions", "builder", "voxel_builder"],
      "default": "scene_actions"
    },
    "allowed_response_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["scene_actions", "scene_patch", "clarification_request", "refusal"]
      }
    },
    "gold_response": {
      "$ref": "response.schema.json"
    },
    "gold_builder": {
      "$ref": "builder.schema.json"
    },
    "gold_voxel_builder": {
      "$ref": "voxel_builder.schema.json"
    },
    "scoring_profile": {
      "$ref": "scoring-profile.schema.json"
    },
    "metadata": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": { "target_artifact": { "const": "scene_actions" } },
            "required": ["target_artifact"]
          },
          { "not": { "required": ["target_artifact"] } }
        ]
      },
      "then": {
        "required": ["gold_response", "allowed_response_types"]
      }
    },
    {
      "if": {
        "properties": { "target_artifact": { "const": "builder" } },
        "required": ["target_artifact"]
      },
      "then": { "required": ["gold_builder"] }
    },
    {
      "if": {
        "properties": { "target_artifact": { "const": "voxel_builder" } },
        "required": ["target_artifact"]
      },
      "then": { "required": ["gold_voxel_builder"] }
    }
  ]
}
