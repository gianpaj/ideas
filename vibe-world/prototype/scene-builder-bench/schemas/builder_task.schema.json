{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "operation", "input_plan_path", "expected_checks"],
  "properties": {
    "task_id": { "type": "string" },
    "operation": { "type": "string", "enum": ["create", "refine", "remix"] },
    "input_plan_path": { "type": "string" },
    "target_intent_id": { "type": ["string", "null"] },
    "object_context_path": { "type": ["string", "null"] },
    "world_settings": {
      "type": "object",
      "properties": {
        "destructive_edits_enabled": { "type": "boolean" },
        "max_part_count": { "type": "integer", "minimum": 1 },
        "max_behavior_count": { "type": "integer", "minimum": 0 },
        "max_instances": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "expected_checks": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "instance_count": { "type": "integer", "minimum": 1 },
        "part_count_min": { "type": "integer", "minimum": 1 },
        "required_materials": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_behaviors": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
